---
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}
const { title, description = "Bigfoot71's personal portfolio - low-level & graphics programming.", image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : new URL('/og-default.png', Astro.site);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonicalURL} />

		<!-- Twitter/X card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header>
			<nav>
				<a href="/">Home</a>
				<a href="/projects">Projects</a>
				<a href="/blog">Blog</a>
				<a href="/demos">Demos</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<Footer />

		<script>
			function enhanceCodeBlocks() {
				document.querySelectorAll<HTMLPreElement>('pre.astro-code').forEach((pre) => {
					if (pre.closest('.code-block')) return; // already enhanced

					const lang = pre.getAttribute('data-language') || 'text';

					const wrapper = document.createElement('div');
					wrapper.className = 'code-block';

					const header = document.createElement('div');
					header.className = 'code-block-header';

					const langLabel = document.createElement('span');
					langLabel.className = 'code-block-lang';
					langLabel.textContent = lang;

					const copyBtn = document.createElement('button');
					copyBtn.className = 'code-block-copy';
					copyBtn.type = 'button';
					copyBtn.textContent = 'Copy';
					copyBtn.addEventListener('click', async () => {
						await navigator.clipboard.writeText(pre.innerText);
						copyBtn.textContent = 'Copied!';
						setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
					});

					header.append(langLabel, copyBtn);

					pre.parentNode?.insertBefore(wrapper, pre);
					wrapper.append(header, pre);
				});
			}

			enhanceCodeBlocks();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0B0E14;
		--surface: #12161F;
		--border: #1E2530;
		--text: #C9D1D9;
		--text-muted: #6B7685;
		--accent: #4CC9FF;

		--font-display: 'JetBrains Mono', monospace;
		--font-body: 'Inter', sans-serif;

		/* Code block background hierarchy: page < header bar < code body */
		--code-header-bg: #161C28;
		--code-body-bg: #1B2230;
		--code-border: #262F40;

		/* Shiki (code syntax highlighting) */
		--astro-code-foreground: #D7DEE7;
		--astro-code-background: var(--code-body-bg);
		--astro-code-token-comment: #6B7685;
		--astro-code-token-keyword: #4CC9FF;
		--astro-code-token-string: #8FD6B4;
		--astro-code-token-string-expression: #8FD6B4;
		--astro-code-token-constant: #E8B368;
		--astro-code-token-function: #B79EF5;
		--astro-code-token-parameter: #E893B8;
		--astro-code-token-punctuation: #8B96A5;
		--astro-code-token-link: #4CC9FF;
	}

	* {
		box-sizing: border-box;
	}

	html, body {
		margin: 0;
		padding: 0;
	}

	body {
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-body);
		line-height: 1.6;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	h1, h2, h3 {
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	a {
		color: var(--accent);
	}

	.catalog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	pre.astro-code {
		margin: 0;
		padding: 1.1rem 1.25rem;
		overflow-x: auto;
		font-size: 0.85rem;
		line-height: 1.6;
		border: none;
		background: var(--code-body-bg) !important;
		font-family: var(--font-display);
	}

	pre.astro-code::-webkit-scrollbar {
		height: 6px;
	}
	pre.astro-code::-webkit-scrollbar-thumb {
		background: var(--border);
		border-radius: 3px;
	}

	code:not(pre code) {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0.15em 0.4em;
		font-size: 0.85em;
		font-family: var(--font-display);
	}

	.code-block {
		margin: 1.75rem 0;
		border-radius: 12px;
		border: 1px solid var(--code-border);
		overflow: hidden;
	}

	.code-block-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 1rem;
		background: var(--code-header-bg);
		border-bottom: 1px solid var(--code-border);
	}

	.code-block-lang {
		font-family: var(--font-display);
		font-size: 0.75rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.code-block-copy {
		font-family: var(--font-display);
		font-size: 0.75rem;
		color: var(--text-muted);
		background: none;
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.25rem 0.6rem;
		cursor: pointer;
		appearance: none;
		transition: border-color 0.2s ease, color 0.2s ease;
	}

	.code-block-copy:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>

<style>
	header {
		display: flex;
		justify-content: center;
		padding: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		gap: 2rem;
		font-family: var(--font-display);
		font-size: 0.9rem;
	}
	nav a {
		position: relative;
		text-decoration: none;
		color: var(--text-muted);
		padding-bottom: 4px;
		transition: color 0.2s ease;
	}
	nav a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 0.25s ease;
	}
	nav a:hover {
		color: var(--text);
	}
	nav a:hover::after {
		transform: scaleX(1);
	}
	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 3rem 2rem;
		flex: 1;
		width: 100%;
	}
</style>
