---
interface Props {
	id: string;
	title: string;
}
const { id, title } = Astro.props;
---
<div class="yt-embed">
	<iframe
		src={`https://www.youtube-nocookie.com/embed/${id}`}
		title={title}
		loading="lazy"
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
		allowfullscreen
	></iframe>
</div>

<style>
	.yt-embed {
		position: relative;
		width: 100%;
		max-width: 800px;
		aspect-ratio: 16 / 9;
		margin: 2.5rem auto;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--border);
	}
	.yt-embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
