---
const socials = [
	{ name: 'GitHub', href: 'https://github.com/Bigfoot71', slug: 'github' },
	{ name: 'YouTube', href: 'https://www.youtube.com/@Bigfoot_71', slug: 'youtube' },
	{ name: 'X', href: 'https://x.com/Bigfoot_71', slug: 'x' },
	{ name: 'itch.io', href: 'https://bigfoot71.itch.io/', slug: 'itchdotio' },
	{ name: 'Ko-fi', href: 'https://ko-fi.com/bigfoot71', slug: 'kofi' },
];
---
<footer>
	<div class="socials">
		{socials.map((s) => (
			<a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
				<span
					class="icon"
					style={`--icon: url(https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/${s.slug}.svg)`}
				></span>
			</a>
		))}
	</div>
	<p>&copy; {new Date().getFullYear()} Bigfoot71</p>
</footer>

<style>
	footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		padding: 2.5rem 1.5rem;
		border-top: 1px solid var(--border);
		margin-top: 3rem;
	}
	.socials {
		display: flex;
		gap: 1.5rem;
	}
	.socials a {
		color: var(--text-muted);
		display: flex;
		transition: color 0.2s ease, transform 0.2s ease;
	}
	.socials a:hover {
		color: var(--accent);
		transform: translateY(-2px);
	}
	.icon {
		width: 20px;
		height: 20px;
		display: inline-block;
		background-color: currentColor;
		-webkit-mask: var(--icon) no-repeat center / contain;
		mask: var(--icon) no-repeat center / contain;
	}
	footer p {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-muted);
	}
</style>
