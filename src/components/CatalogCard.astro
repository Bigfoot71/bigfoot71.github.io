---
interface Props {
	href: string;
	title: string;
	image?: string;
}
const { href, title, image } = Astro.props;

const letter = title.trim().charAt(0).toUpperCase();
---
<a href={href} class="card">
	{image ? (
		<img src={image} alt={title} />
	) : (
		<div class="placeholder">
			<span class="monogram">{letter}</span>
		</div>
	)}
	<div class="overlay">
		<h3>{title}</h3>
	</div>
</a>

<style>
	.card {
		position: relative;
		display: block;
		aspect-ratio: 4 / 3;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--border);
		background: var(--surface);
		text-decoration: none;
	}
	.card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.3s ease;
	}
	.card:hover img {
		transform: scale(1.05);
	}

	.placeholder {
		width: 100%;
		height: 100%;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--surface), #171D29);
		overflow: hidden;
	}
	.placeholder::before {
		content: '';
		position: absolute;
		inset: 0;
		opacity: 0.3;
		background-image: linear-gradient(var(--border) 1px, transparent 1px),
			linear-gradient(90deg, var(--border) 1px, transparent 1px);
		background-size: 24px 24px;
	}

	.monogram {
		position: relative;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 6rem;
		color: var(--accent);
		opacity: 0.35;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}
	.card:hover .monogram {
		opacity: 0.6;
		transform: scale(1.08);
	}

	.overlay {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 0.75rem 1rem;
		background: linear-gradient(to top, rgba(11, 14, 20, 0.9), transparent);
	}
	.overlay h3 {
		margin: 0;
		font-size: 1rem;
	}
</style>
