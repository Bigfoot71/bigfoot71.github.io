---
import PlayButton from './PlayButton.astro';

interface Props {
	path: string;
	title: string;
	width: number;
	height: number;
	isolated?: boolean;
}
const { path, title, width, height, isolated = false } = Astro.props;
---

<div class="wasm-demo" data-wasm-isolated={isolated ? '' : undefined} data-src={path} style={`--w: ${width}; --h: ${height};`}>
	<iframe title={title} allow="autoplay; gamepad; fullscreen"></iframe>
	<button class="play-overlay play-trigger" type="button" aria-label={`Launch: ${title}`}>
		<PlayButton label="Click to launch" />
	</button>
</div>

<script>
	// Isolation cross-origin
	async function ensureIsolation() {
		const needed = Array.from(document.querySelectorAll<HTMLElement>('.wasm-demo')).some(
			(d) => d.dataset.wasmIsolated !== undefined,
		);
		if (!needed || !('serviceWorker' in navigator)) return;

		if (crossOriginIsolated) {
			sessionStorage.removeItem('wasm-sw-reloaded');
			return;
		}

		const base = import.meta.env.BASE_URL.replace(/\/$/, '');
		await navigator.serviceWorker.register(`${base}/wasm-sw.js`);
		await navigator.serviceWorker.ready;

		if (!sessionStorage.getItem('wasm-sw-reloaded')) {
			sessionStorage.setItem('wasm-sw-reloaded', '1');
			location.reload();
		}
	}
	ensureIsolation();

	// Launch with style override
	const SHELL_OVERRIDE = `
		html, body, .canvas-container, canvas {
			width: 100% !important;
			height: 100% !important;
		}
	`;

	function launch(demo: HTMLElement) {
		const iframe = demo.querySelector('iframe')!;

		iframe.addEventListener(
			'load',
			() => {
				const doc = iframe.contentDocument;
				if (doc) {
					const style = doc.createElement('style');
					style.textContent = SHELL_OVERRIDE;
					doc.head.append(style);
				}
				demo.classList.add('ready');

				// Workaround: Firefox won't clip a WebGL canvas created afterward unless
				// the value differs from the CSS one. Don't "fix" this by using just --r
				demo.style.clipPath = 'inset(0 round calc(var(--r) - 0.01px))';

				iframe.focus();
			},
			{ once: true },
		);

		iframe.src = demo.dataset.src!;
		demo.querySelector('.play-overlay')!.remove();
	}

	document.querySelectorAll<HTMLElement>('.wasm-demo').forEach((demo) => {
		demo
			.querySelector('.play-overlay')
			?.addEventListener('click', () => launch(demo), { once: true });
	});
</script>

<style>
	.wasm-demo {
		--r: 16px;
		--bg: #06162d;

		position: relative;
		width: 100%;
		max-width: calc(var(--w) * 1px);
		aspect-ratio: var(--w) / var(--h);
		margin: 2.5rem auto;
		background: var(--bg);
		clip-path: inset(0 round var(--r));
	}

	iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.wasm-demo:not(.ready) iframe {
		opacity: 0;
	}

	/* Border drawn over the content */
	.wasm-demo::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		border-radius: var(--r);
		box-shadow: inset 0 0 0 1px var(--border);
	}

	.play-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		color: var(--text);
		font-family: var(--font-display);
		font-size: 0.9rem;
		cursor: pointer;
		transition: background 0.2s ease;
	}
	.play-overlay:hover {
		background: color-mix(in srgb, var(--bg) 70%, transparent);
	}
	.play-overlay:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
</style>
